# ============================================================================
# Variables d'environnement — « J'ai ma nounou »
# Copiez ce fichier en `.env.local` et renseignez les valeurs.
# `npx supabase start` affiche les URL/clés locales à utiliser.
# ============================================================================

# URL de l'API Supabase (local : http://127.0.0.1:54331 — voir supabase/config.toml)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331

# Clé publique « anon » (exposée au client — OK)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxzc3FqanFzemh3cWV0Y2lmZHB1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg0NzAxMjQsImV4cCI6MjEwNDA0NjEyNH0._TCuQhBBAQKghVrdAV4r6i_dwMtZJs7J3UQqvXOqQTY

# Clé « service_role » — SECRÈTE, serveur uniquement. NE JAMAIS committer une vraie clé.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imxzc3FqanFzemh3cWV0Y2lmZHB1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODQ3MDEyNCwiZXhwIjoyMTA0MDQ2MTI0fQ.hDvUiJAhBFvk-0bks_EsKVX8ZKcZvwFyB_ohaB-xm1A

# URL publique de l'app — le domaine du SITE (jamais l'URL Supabase !).
# Local : http://localhost:3000 · Prod : https://jaimanounou.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ============================================================================
# Connexion Google (OAuth). Créez un identifiant OAuth « Web » sur
# https://console.cloud.google.com/apis/credentials et autorisez l'URI de
# callback Supabase (local : http://127.0.0.1:54331/auth/v1/callback ;
# prod : https://<projet>.supabase.co/auth/v1/callback).
# En prod, ces valeurs se règlent aussi dans Supabase > Auth > Providers > Google.
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ============================================================================
# Paiement — laisser vide = mock (paiement simulé, dev). Renseigner pour le réel.
# Routage : moyen « carte » -> PAYMENT_CARD_PROVIDER ; Mobile Money -> PAYMENT_MOBILE_PROVIDER.
# Webhooks à configurer chez le fournisseur :
#   {NEXT_PUBLIC_APP_URL}/api/paiement/webhook/cartflox | /cinetpay | /paydunya | /stripe
# ============================================================================
PAYMENT_MOBILE_PROVIDER=mock          # mock | cartflox | cinetpay | paydunya
PAYMENT_CARD_PROVIDER=mock            # mock | stripe

# --- Cartflox (agrégateur Mobile Money africain) ---
# La clé secrète sert à l'API ET à vérifier la signature des webhooks.
# TEST (sans vérification d'identité) : af_test_sec_… → mets PAYMENT_MOBILE_PROVIDER=cartflox.
# Webhook à déclarer dans Cartflox : {NEXT_PUBLIC_APP_URL}/api/paiement/webhook/cartflox
CARTFLOX_SECRET_KEY=
# CARTFLOX_API_BASE=https://cartflox.com/api/v1   # (facultatif, défaut)

# --- CinetPay (Mobile Money) ---
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# --- PayDunya (Mobile Money) ---
PAYDUNYA_MODE=test                    # test | live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- Stripe (carte bancaire) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Paiement mobile money « relais local » (particulier, sans entreprise) ---
# Le client paie sur ton compte Orange Money / Wave, puis déclare la transaction
# dans l'app ; un admin la valide (page Revenus). Valeurs PUBLIQUES (affichées au client).
# Renseigne au moins un canal (numéro OM, numéro Wave, ou lien marchand Wave).
#
# Wave : colle ton lien marchand SANS le montant (l'app ajoute le bon montant
# selon le tarif). Ex. https://pay.wave.com/m/M_ci_xxxxx/c/ci/
NEXT_PUBLIC_WAVE_MERCHANT_LINK=
NEXT_PUBLIC_MANUAL_PAY_OM=
NEXT_PUBLIC_MANUAL_PAY_WAVE=
NEXT_PUBLIC_MANUAL_PAY_NAME=

# ============================================================================
# Cron — réconciliation automatique des paiements (deploy/cron-reconcile.sh).
# Secret partagé entre le cron du VPS et l'endpoint /api/cron/reconcilier.
# Générer une valeur robuste : openssl rand -hex 32
# ============================================================================
CRON_SECRET=

# --- Relances e-mail d'onboarding (deploy/cron-relances.sh) ---
# Secret des liens de désinscription. openssl rand -hex 32
EMAIL_UNSUB_SECRET=
