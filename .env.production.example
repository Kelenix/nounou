# ============================================================================
# Variables d'environnement PRODUCTION — « J'ai ma nounou »
# Copiez ce fichier en `.env.production` SUR LE VPS et renseignez les valeurs.
# NE JAMAIS committer `.env.production` (secrets). Déjà couvert par .gitignore.
#
# Deux familles :
#  - NEXT_PUBLIC_*  : publiques, "gelées" au BUILD (passées en --build-arg).
#  - le reste       : secrets serveur, passés au RUN (--env-file .env.production).
# ============================================================================

# --- Supabase Cloud (projet de production) ---
NEXT_PUBLIC_SUPABASE_URL=https://lssqjjqszhwqetcifdpu.supabase.co
# Clé publique "anon" du projet CLOUD (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REMPLACER_PAR_LA_CLE_ANON_CLOUD
# Clé "service_role" du projet CLOUD — SECRÈTE, serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_PAR_LA_CLE_SERVICE_ROLE_CLOUD

# --- URL publique de l'app (le domaine du SITE) ---
NEXT_PUBLIC_APP_URL=https://jaimanounou.com

# --- Analytics (optionnel, respectueux de la vie privée : Plausible / Umami) ---
# Laisser vide = désactivé. Si renseigné, le script est injecté et la CSP l'autorise.
# Ex. Plausible cloud : DOMAIN=jaimanounou.com  SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=

# --- Emails transactionnels (Resend) — notifications par email ---
# Laisser vide = emails désactivés (notifications in-app uniquement).
RESEND_API_KEY=
# Expéditeur (domaine vérifié chez Resend), ex. "J'ai ma nounou <no-reply@jaimanounou.com>"
EMAIL_FROM=
# Secret partagé avec le webhook Supabase (Database → Webhooks → en-tête x-webhook-secret).
NOTIFICATION_HOOK_SECRET=
# Secret des liens de désinscription des relances e-mail. openssl rand -hex 32
EMAIL_UNSUB_SECRET=

# --- SMS OTP via SMS Pro Africa (connexion par téléphone) ---
# Jeton API : Espace Développeurs SMS Pro Africa (à régénérer si exposé).
SMSPRO_API_TOKEN=
# Nom d'expéditeur validé (max 11 caractères), ex. JaiMaNounou.
SMSPRO_SENDER_ID=JaiMaNounou
# Secret du hook « Send SMS » (Supabase → Authentication → Hooks → Send SMS).
# Format : v1,whsec_xxxxxxxx
SEND_SMS_HOOK_SECRET=

# --- Paiement Mobile Money : Cartflox (agrégateur, paiement automatique) ---
# Mettre `cartflox` pour l'encaissement réel via Cartflox.
PAYMENT_MOBILE_PROVIDER=cartflox
PAYMENT_CARD_PROVIDER=mock
# Clé SECRÈTE de PRODUCTION Cartflox (af_live_sec_…), nécessite la vérification
# d'identité côté Cartflox. Sert à l'API ET à vérifier la signature des webhooks.
# La clé PUBLIQUE (af_live_pub_…) n'est PAS nécessaire côté serveur.
# Webhook à déclarer dans Cartflox : {NEXT_PUBLIC_APP_URL}/api/paiement/webhook/cartflox
CARTFLOX_SECRET_KEY=

# CinetPay / PayDunya / Stripe : alternatives (laisser vide si tu utilises Cartflox)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cron : réconciliation automatique des paiements (deploy/cron-reconcile.sh) ---
# Secret partagé entre le cron du VPS et l'endpoint /api/cron/reconcilier.
# Générer : openssl rand -hex 32
CRON_SECRET=
