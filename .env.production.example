# ============================================================================
# Variables d'environnement PRODUCTION — « J'ai ma nounou »
# Copiez ce fichier en `.env.production` SUR LE VPS et renseignez les valeurs.
# NE JAMAIS committer `.env.production` (secrets). Déjà couvert par .gitignore.
#
# Deux familles :
#  - NEXT_PUBLIC_*  : publiques, "gelées" au BUILD (passées en --build-arg).
#  - le reste       : secrets serveur, passés au RUN (--env-file .env.production).
# ============================================================================

# --- Supabase Cloud (projet de production) ---
NEXT_PUBLIC_SUPABASE_URL=https://lssqjjqszhwqetcifdpu.supabase.co
# Clé publique "anon" du projet CLOUD (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REMPLACER_PAR_LA_CLE_ANON_CLOUD
# Clé "service_role" du projet CLOUD — SECRÈTE, serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_PAR_LA_CLE_SERVICE_ROLE_CLOUD

# --- URL publique de l'app (le domaine du SITE) ---
NEXT_PUBLIC_APP_URL=https://jaimanounou.com

# --- Paiement : mock pour le lancement (à brancher plus tard) ---
PAYMENT_MOBILE_PROVIDER=mock
PAYMENT_CARD_PROVIDER=mock

# CinetPay / PayDunya / Stripe : à renseigner quand les comptes seront prêts
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
